rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS & RBAC ENFORCEMENT
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Retrieve role from token claim first, or fallback to user profile document
    function getUserRole() {
      return request.auth.token.role != null 
        ? request.auth.token.role 
        : (exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) 
            ? get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role 
            : 'citizen');
    }
    
    function isOfficer() {
      return isAuthenticated() && (
        getUserRole() in [
          'union_officer', 'union_land_officer',
          'ac_land', 'ac_land_officer',
          'sub_registrar', 'sub_registry_officer',
          'central_admin', 'admin'
        ]
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() in ['central_admin', 'admin']
      );
    }

    function isPrivilegeUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'citizen_id', 'citizenId', 'kyc_status', 'kycStatus', 'isDemo']);
    }

    // =========================================================================
    // USER PROFILES
    // =========================================================================
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficer());
      // Users can only create their own profile, with default citizen role
      allow create: if isAuthenticated() && isOwner(userId) && (
        request.resource.data.role == 'citizen' || request.resource.data.role == null
      );
      // Self update allows non-privileged fields only; Admin can update roles
      allow update: if isAuthenticated() && (
        (isOwner(userId) && isPrivilegeUnchanged()) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Alias for users collection if referenced
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficer());
      allow create: if isAuthenticated() && isOwner(userId) && (
        request.resource.data.role == 'citizen' || request.resource.data.role == null
      );
      allow update: if isAuthenticated() && (
        (isOwner(userId) && isPrivilegeUnchanged()) || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // LAND PARCELS, KHATIANS & OWNERSHIP
    // =========================================================================
    match /land_parcels/{parcelId} {
      // Public land due diligence search
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }
    
    match /khatian_records/{khatianId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    match /land_ownerships/{ownershipId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    // =========================================================================
    // SENSITIVE LAND DOCUMENTS
    // =========================================================================
    match /land_documents/{docId} {
      allow read: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isOfficer()
      );
      allow write: if isOfficer() || isAdmin();
    }

    // =========================================================================
    // TAX & KHAJNA
    // =========================================================================
    match /khajna_accounts/{accountId} {
      allow read: if isAuthenticated() && (
        resource.data.owner_id == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isOfficer()
      );
      allow write: if isOfficer() || isAdmin();
    }

    match /tax_payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        isOfficer()
      );
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tax_clearances/{clearanceId} {
      allow read: if isAuthenticated() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.owner_id == request.auth.uid || 
        isOfficer()
      );
      allow write: if isOfficer() || isAdmin();
    }

    // =========================================================================
    // SALE APPLICATIONS & PRE-CHECKS
    // =========================================================================
    match /sale_applications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.seller_id == request.auth.uid || 
        resource.data.buyer_id == request.auth.uid || 
        isOfficer()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.seller_id == request.auth.uid ||
        request.resource.data.seller_uid == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        (resource.data.seller_id == request.auth.uid && resource.data.status in ['draft', 'submitted']) || 
        isOfficer() || 
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // =========================================================================
    // RISK ASSESSMENTS (CHECK BEFORE YOU BUY)
    // =========================================================================
    match /risk_assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // OFFICE REVIEWS & APPLICATION WORKFLOWS
    // =========================================================================
    match /office_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create, update: if isOfficer() || isAdmin();
      allow delete: if isAdmin();
    }

    match /registration_appointments/{aptId} {
      allow read: if isAuthenticated() && (
        resource.data.seller_id == request.auth.uid || 
        resource.data.buyer_id == request.auth.uid || 
        isOfficer()
      );
      allow write: if isOfficer() || isAdmin();
    }

    match /registration_records/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.seller_id == request.auth.uid || 
        resource.data.buyer_id == request.auth.uid || 
        isOfficer()
      );
      allow write: if isOfficer() || isAdmin();
    }

    match /mutation_applications/{mutationId} {
      allow read: if isAuthenticated() && (
        resource.data.applicant_id == request.auth.uid || 
        resource.data.buyer_id == request.auth.uid || 
        isOfficer()
      );
      allow create: if isAuthenticated();
      allow update: if isOfficer() || isAdmin();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{notificationId} {
      allow read, update, delete: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // =========================================================================
    // AUDIT LOGS (APPEND-ONLY, IMMUTABLE)
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Strict immutability
    }
  }
}
