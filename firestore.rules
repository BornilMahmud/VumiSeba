rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOfficer() {
      return isAuthenticated() && (
        request.auth.token.role in ['union_officer', 'ac_land', 'sub_registrar', 'central_admin']
      );
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'central_admin';
    }

    // Profiles: users can read their own, officers can read all, admins manage
    match /profiles/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isOfficer());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
    }

    // Public / Searchable Land Parcels & Khatians: read-only for authenticated citizens & search queries
    match /land_parcels/{parcelId} {
      allow read: if true; // Public land search with non-sensitive fields
      allow write: if isOfficer() || isAdmin();
    }
    
    match /khatian_records/{khatianId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    // Ownership records
    match /land_ownerships/{ownershipId} {
      allow read: if true;
      allow write: if isOfficer() || isAdmin();
    }

    // Land documents: sensitive, only owner or officers
    match /land_documents/{docId} {
      allow read: if isAuthenticated() && (resource.data.owner_id == request.auth.uid || isOfficer());
      allow write: if isOfficer() || isAdmin();
    }

    // Tax & Khajna Accounts: owner or officers
    match /khajna_accounts/{accountId} {
      allow read: if isAuthenticated() && (resource.data.owner_id == request.auth.uid || isOfficer());
      allow write: if isOfficer() || isAdmin();
    }

    match /tax_payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isOfficer());
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /tax_clearances/{clearanceId} {
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isOfficer());
      allow write: if isOfficer() || isAdmin();
    }

    // Sale Applications: buyer, seller, or authorized officers
    match /sale_applications/{appId} {
      allow read: if isAuthenticated() && (
        resource.data.seller_id == request.auth.uid || 
        resource.data.buyer_id == request.auth.uid || 
        isOfficer()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        resource.data.seller_id == request.auth.uid || isOfficer()
      );
      allow delete: if isAdmin();
    }

    // Risk assessments: readable by authenticated users evaluating a parcel
    match /risk_assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Office reviews, Registration & Mutation records: officers & admin
    match /office_reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer() || isAdmin();
    }

    match /registration_appointments/{aptId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer() || isAdmin();
    }

    match /registration_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer() || isAdmin();
    }

    match /mutation_applications/{mutationId} {
      allow read: if isAuthenticated();
      allow write: if isOfficer() || isAdmin();
    }

    // Notifications: owner only
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated();
    }

    // Audit logs: read-only for admin
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
