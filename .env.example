# =============================================================================
# VumiSeba (ভূমিসেবা) — Environment Variables & Configuration Template
# =============================================================================
#
# IMPORTANT: Never commit actual secret keys or credentials to Git.
# Copy this file to .env for local development.
# Configure these variables in Vercel (Frontend) and Render (Backend) dashboards.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vercel Environment Variables)
# -----------------------------------------------------------------------------
# Base URL for Backend API requests.
# In local development: leave empty to use Vite proxy (/api).
# In production (Vercel): set to your deployed Render URL (e.g., https://vumiseba-backend.onrender.com/api)
VITE_API_BASE_URL=

# Firebase Client Web SDK (Project: landtech-e5773)
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=landtech-e5773.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=landtech-e5773
VITE_FIREBASE_STORAGE_BUCKET=landtech-e5773.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_here

# -----------------------------------------------------------------------------
# 2. BACKEND API CONFIGURATION (Render Environment Variables)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_jwt_secret_in_production
# Allowed Frontend Origins for CORS (comma-separated or * in production)
CORS_ORIGIN=http://localhost:3000

# Backend Firebase Project Identifier
FIREBASE_PROJECT_ID=landtech-e5773

# Optional: Path to Firebase Admin SDK Service Account JSON for server-side auth verification
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Simulated Government Adapters (Set to true for MVP simulation)
SIMULATE_SMS=true
SIMULATE_EMAIL=true
