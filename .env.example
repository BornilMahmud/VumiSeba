# Bhumisathi Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=bhumisathi-super-secret-jwt-key-2026-bangladesh
CORS_ORIGIN=http://localhost:3000

# Firebase Client Configuration (Optional - falls back seamlessly to local persistent storage if not set)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=landtech-bhumisathi
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin Service Account (Optional for cloud execution)
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=landtech-bhumisathi

# Notification Adapters (Simulated by default)
SIMULATE_SMS=true
SIMULATE_EMAIL=true
