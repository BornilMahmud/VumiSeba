{
  "name": "vumiseba-landtech",
  "version": "1.0.0",
  "description": "VumiSeba (ভূমিসেবা) - Bangladesh Citizen Land Services, Ownership Verification, Smart Registry & e-Mutation Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build && tsc -p server/tsconfig.json",
    "build:client": "vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "node dist-server/server/index.js",
    "preview": "vite preview",
    "seed": "tsx server/db/seed.ts",
    "seed:firestore": "tsx scripts/seedFirestore.ts",
    "admin:bootstrap": "tsx scripts/bootstrapAdmin.ts",
    "test": "tsx server/tests/e2e-workflow.test.ts",
    "test:firebase": "tsx server/tests/firebase-auth-rules.test.ts"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "firebase": "^11.6.1",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
